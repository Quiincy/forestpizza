datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RestaurantSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  order     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String
  price30     Float?
  price40     Float?
  priceSingle Float?
  imageUrl    String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  badge       String?
  isAvailable Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reservation {
  id            String   @id @default(cuid())
  customerName  String
  phone         String
  date          String
  time          String
  comment       String?
  status        String   @default("NEW")
  telegramSent  Boolean  @default(false)
  telegramError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  customerName String
  phone        String
  orderType    String   @default("TAKEAWAY")
  address      String?
  pickupTime   String?
  itemsJson    String
  totalPrice   Float
  comment      String?
  status       String   @default("NEW")
  telegramSent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
